<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuperSampler.Abstractions\SuperSampler.Abstractions.csproj" />
    <ProjectReference Include="..\SuperSampler.Drivers.Modbus\SuperSampler.Drivers.Modbus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="2.11.58" />
    <!--
      发布打包（把 Jint 合并进单 DLL）用的 MSBuild 任务。
      PrivateAssets=all：合包工具不进最终产物依赖；
      合并目标本身在同目录 ILRepack.targets，只在 -p:EnableILRepack=true 时执行（见该文件注释）。
    -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
  </ItemGroup>
</Project>
